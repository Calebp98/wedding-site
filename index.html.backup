<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>Our Story</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/tufte-css/1.8.0/tufte.min.css"/>
    <style>
        body {
            background-color: #fffff8;
        }

        .timeline-section {
            margin: 4rem 0;
            padding: 2rem 0;
            border-left: 2px solid #111;
            padding-left: 2rem;
            position: relative;
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .timeline-section.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .timeline-section::before {
            content: '';
            position: absolute;
            left: -6px;
            top: 2rem;
            width: 10px;
            height: 10px;
            background-color: #111;
            border: 2px solid #fffff8;
        }

        .timeline-date {
            font-variant: small-caps;
            letter-spacing: 0.1em;
            color: #555;
            margin-bottom: 0.5rem;
        }

        .timeline-title {
            font-size: 1.5rem;
            font-weight: 400;
            margin: 0.5rem 0 1rem 0;
        }

        .hero {
            text-align: center;
            padding: 4rem 0;
            margin-bottom: 3rem;
        }

        .hero h1 {
            font-size: 3rem;
            font-weight: 400;
            margin-bottom: 1rem;
        }

        .hero p {
            font-size: 1.2rem;
            color: #555;
            font-style: italic;
        }

        .divider {
            text-align: center;
            margin: 3rem 0;
            color: #999;
            opacity: 0;
            transform: translateY(30px);
            transition: opacity 0.8s ease, transform 0.8s ease;
        }

        .divider.visible {
            opacity: 1;
            transform: translateY(0);
        }

        .days-counter {
            position: fixed;
            right: 5%;
            top: 50%;
            transform: translateY(-50%);
            text-align: center;
            padding: 2rem;
            border: 2px solid #111;
            background-color: #fffff8;
            min-width: 200px;
            z-index: 1000;
        }

        .days-counter .number {
            font-size: 4rem;
            font-weight: 400;
            line-height: 1;
            color: #111;
            display: block;
            margin: 0.5rem 0;
            transition: all 0.5s ease;
        }

        .days-counter .label {
            font-variant: small-caps;
            letter-spacing: 0.15em;
            color: #555;
            font-size: 0.9rem;
        }

        .days-counter .sublabel {
            font-size: 0.75rem;
            color: #999;
            margin-top: 0.5rem;
            font-style: italic;
        }

        @media (max-width: 760px) {
            .days-counter {
                position: fixed;
                right: auto;
                left: 50%;
                top: auto;
                bottom: 20px;
                transform: translateX(-50%);
                min-width: 160px;
                padding: 1rem;
            }

            .days-counter .number {
                font-size: 2.5rem;
            }

            .days-counter .label {
                font-size: 0.75rem;
            }

            .days-counter .sublabel {
                font-size: 0.65rem;
            }
        }

        @media (max-width: 760px) {
            .timeline-section {
                margin: 2rem 0;
                padding-left: 1.5rem;
            }

            .hero h1 {
                font-size: 2rem;
            }

            .hero p {
                font-size: 1rem;
            }

            .timeline-title {
                font-size: 1.2rem;
            }
        }
    </style>
</head>
<body>
    <div class="days-counter">
        <div class="label">Days Until</div>
        <span class="number" id="days-count">0</span>
        <div class="label">The Wedding</div>
        <div class="sublabel" id="event-name"></div>
    </div>

    <article>
        <div class="hero">
            <h1>Our Story</h1>
            <p>A journey of love</p>
        </div>

        <section class="timeline-section" data-event-date="2026-06-15" data-event-name="The Wedding">
            <div class="timeline-date">Present Day</div>
            <h2 class="timeline-title">The Wedding</h2>
            <p>Today we celebrate the beginning of our forever. Surrounded by loved ones, we promise to walk through life together, hand in hand, heart to heart.</p>
            <p>This is not the end of our story—it's the most beautiful chapter yet to unfold.</p>
        </section>

        <section class="timeline-section" data-event-date="2025-03-20" data-event-name="The Proposal">
            <div class="timeline-date">March 2025</div>
            <h2 class="timeline-title">The Proposal</h2>
            <p>The moment we decided to make it official. <span class="marginnote">Add your proposal story here—where were you, what made it special, how did it feel?</span></p>
            <p>A memory we'll treasure forever, the day our future became certain.</p>
        </section>

        <section class="timeline-section" data-event-date="2023-09-10" data-event-name="Growing Together">
            <div class="timeline-date">September 2023</div>
            <h2 class="timeline-title">Growing Together</h2>
            <p>Through seasons of change, we grew stronger. Late-night conversations, shared dreams, quiet moments that meant everything.</p>
            <p>We learned that love isn't just a feeling—it's a choice we make every day.</p>
        </section>

        <section class="timeline-section" data-event-date="2022-07-04" data-event-name="The First Adventure">
            <div class="timeline-date">July 2022</div>
            <h2 class="timeline-title">The First Adventure</h2>
            <p>Our first trip together. <span class="marginnote">Replace with your first meaningful trip or adventure as a couple.</span></p>
            <p>We discovered that the best journeys are the ones we take together.</p>
        </section>

        <section class="timeline-section" data-event-date="2021-11-25" data-event-name="Falling Deeper">
            <div class="timeline-date">November 2021</div>
            <h2 class="timeline-title">Falling Deeper</h2>
            <p>Somewhere between the laughter and the ordinary days, we realized this was different. This was real.</p>
            <p>The kind of love that makes you believe in forever.</p>
        </section>

        <section class="timeline-section" data-event-date="2021-05-14" data-event-name="The First Date">
            <div class="timeline-date">May 2021</div>
            <h2 class="timeline-title">The First Date</h2>
            <p>Nervous excitement, hopeful hearts. We didn't know then that this was the beginning of everything.</p>
            <p>Sometimes the best stories start with the smallest moments.</p>
        </section>

        <section class="timeline-section" data-event-date="2021-04-01" data-event-name="The First Hello">
            <div class="timeline-date">April 2021</div>
            <h2 class="timeline-title">The First Hello</h2>
            <p>Two paths crossed. A chance encounter, a shared glance, a conversation that changed everything.</p>
            <p>This is where our story begins. <span class="marginnote">Tell your origin story—how did you meet? What do you remember about that first meeting?</span></p>
        </section>

        <div class="divider">
            <p>✦ ✦ ✦</p>
            <p style="font-style: italic; margin-top: 2rem;">Every love story is beautiful, but ours is our favorite.</p>
        </div>
    </article>

    <script>
        // Get wedding date from first section (update this to your actual wedding date)
        const weddingDateStr = document.querySelector('[data-event-date]').getAttribute('data-event-date');
        const weddingDate = new Date(weddingDateStr);

        // Elements
        const daysCountElement = document.getElementById('days-count');
        const eventNameElement = document.getElementById('event-name');

        // Calculate days between two dates
        function calculateDays(date1, date2) {
            const oneDay = 24 * 60 * 60 * 1000;
            return Math.round(Math.abs((date2 - date1) / oneDay));
        }

        // Update counter for a given section
        function updateCounter(section) {
            const eventDateStr = section.getAttribute('data-event-date');
            const eventName = section.getAttribute('data-event-name');

            if (eventDateStr) {
                const eventDate = new Date(eventDateStr);
                const days = calculateDays(eventDate, weddingDate);

                // Animate the number change
                const currentDays = parseInt(daysCountElement.textContent) || 0;
                animateNumber(currentDays, days);

                // Update event name
                if (eventName !== 'The Wedding') {
                    eventNameElement.textContent = `from ${eventName}`;
                } else {
                    eventNameElement.textContent = '';
                }
            }
        }

        // Animate number counting
        function animateNumber(start, end) {
            const duration = 500;
            const steps = 20;
            const stepValue = (end - start) / steps;
            const stepDuration = duration / steps;
            let current = start;
            let step = 0;

            const timer = setInterval(() => {
                step++;
                current += stepValue;
                if (step >= steps) {
                    daysCountElement.textContent = end.toLocaleString();
                    clearInterval(timer);
                } else {
                    daysCountElement.textContent = Math.round(current).toLocaleString();
                }
            }, stepDuration);
        }

        // Intersection Observer for scroll-triggered animations
        const observerOptions = {
            threshold: 0.5,
            rootMargin: '0px 0px -200px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.classList.add('visible');

                    // Update counter if it's a timeline section
                    if (entry.target.classList.contains('timeline-section')) {
                        updateCounter(entry.target);
                    }
                }
            });
        }, observerOptions);

        // Observe all timeline sections and divider
        document.querySelectorAll('.timeline-section, .divider').forEach(element => {
            observer.observe(element);
        });

        // Initialize with first section
        const firstSection = document.querySelector('.timeline-section');
        if (firstSection) {
            updateCounter(firstSection);
        }
    </script>
</body>
</html>
