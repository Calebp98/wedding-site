<style>
  .accom-wrapper {
    max-width: 700px;
    margin: 0 auto;
  }

  .accom-intro {
    font-size: 1rem;
    color: #555;
    line-height: 1.7;
    margin: 0 0 2.5rem 0;
    font-style: italic;
    border-left: 3px solid #ddd;
    padding-left: 1rem;
  }

  .accom-category {
    margin-bottom: 3rem;
    border-left: 3px solid #111;
    padding-left: 1.5rem;
  }

  .accom-cat-title {
    font-size: 1.2rem;
    font-weight: 500;
    margin: 0 0 1.5rem 0;
    color: #111;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.9rem;
  }

  .accom-item {
    margin-bottom: 1.5rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid #eee;
  }

  .accom-item:last-of-type {
    border-bottom: none;
    margin-bottom: 0;
    padding-bottom: 0;
  }

  .accom-item h4 {
    font-size: 1.05rem;
    font-weight: 500;
    margin: 0 0 0.2rem 0;
    color: #111;
  }

  .accom-item p {
    margin: 0.2rem 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: #444;
  }

  .accom-address {
    color: #777 !important;
    font-size: 0.85rem !important;
  }

  .accom-book {
    font-size: 0.85rem !important;
    color: #555 !important;
  }

  .accom-contact {
    font-size: 0.85rem !important;
    color: #555 !important;
  }

  .accom-note {
    margin-top: 1.5rem !important;
    font-size: 0.85rem !important;
    color: #777 !important;
    font-style: italic;
    border-bottom: none !important;
  }

  .accom-taxis .accom-taxi-note {
    font-size: 0.9rem;
    color: #555;
    margin: 0 0 1.25rem 0;
    line-height: 1.6;
  }

  .taxi-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.6rem;
  }

  .taxi-list li {
    font-size: 0.95rem;
    color: #333;
    display: flex;
    gap: 0.75rem;
    align-items: baseline;
  }

  .taxi-name {
    font-weight: 500;
    min-width: 160px;
    flex-shrink: 0;
  }

  .taxi-note {
    font-size: 0.8rem;
    color: #888;
    margin-left: 0.25rem;
  }

  @media (max-width: 768px) {
    .accom-category {
      padding-left: 1rem;
    }

    .taxi-name {
      min-width: 130px;
    }
  }
</style>
