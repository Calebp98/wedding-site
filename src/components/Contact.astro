---
// Contact Information Component
---

<div class="contact-section">
  <h2 class="section-title">Questions?</h2>
  <p class="section-subtitle">We're here to help</p>

  <div class="contact-grid">
    <div class="contact-item">
      <h3>For General Inquiries</h3>
      <p class="contact-name">Bride & Groom</p>
      <a href="mailto:hello@ourwedding.com" class="contact-link">
        hello@ourwedding.com
      </a>
    </div>

    <div class="contact-item">
      <h3>Wedding Coordinator</h3>
      <p class="contact-name">Jane Smith Events</p>
      <a href="mailto:coordinator@example.com" class="contact-link">
        coordinator@example.com
      </a>
      <a href="tel:+15551234567" class="contact-link">(555) 123-4567</a>
    </div>

    <div class="contact-item">
      <h3>Venue Contact</h3>
      <p class="contact-name">The Beautiful Venue</p>
      <a href="mailto:events@venue.com" class="contact-link">
        events@venue.com
      </a>
      <a href="tel:+15552345678" class="contact-link">(555) 234-5678</a>
    </div>
  </div>

  <div class="contact-note">
    <p>
      For last-minute questions or emergencies on the wedding day, please
      contact our wedding coordinator directly at <a href="tel:+15551234567"
        >(555) 123-4567</a
      >.
    </p>
  </div>
</div>

<style>
  .contact-section {
    max-width: 700px;
    margin: 0 auto 4rem;
    padding: 3rem 2rem;
    border: 2px solid #111;
    background-color: #fffff8;
    width: 100%;
    box-sizing: border-box;
  }

  .section-title {
    font-size: 2rem;
    font-weight: 400;
    text-align: center;
    margin: 0 0 0.5rem 0;
    color: #111;
  }

  .section-subtitle {
    text-align: center;
    font-style: italic;
    color: #555;
    font-size: 0.95rem;
    margin: 0 0 2.5rem 0;
  }

  .contact-grid {
    display: grid;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .contact-item {
    padding-bottom: 2rem;
    border-bottom: 1px solid #ddd;
  }

  .contact-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .contact-item h3 {
    font-size: 1.2rem;
    font-weight: 400;
    margin: 0 0 0.8rem 0;
    color: #111;
  }

  .contact-name {
    margin: 0 0 0.8rem 0;
    font-size: 0.95rem;
    color: #555;
  }

  .contact-link {
    display: block;
    margin: 0.4rem 0;
    font-size: 0.95rem;
    color: #111;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .contact-link:hover {
    color: #555;
  }

  .contact-note {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid #ddd;
  }

  .contact-note p {
    margin: 0;
    font-size: 0.9rem;
    color: #555;
    line-height: 1.6;
  }

  .contact-note a {
    color: #111;
    text-decoration: none;
    border-bottom: 1px solid #ddd;
    transition: border-color 0.2s ease;
  }

  .contact-note a:hover {
    border-color: #111;
  }

  @media (max-width: 768px) {
    .contact-section {
      padding: 2rem 1.5rem;
      margin: 0 1rem 3rem;
    }

    .section-title {
      font-size: 1.5rem;
    }

    .contact-item h3 {
      font-size: 1.1rem;
    }

    .contact-name,
    .contact-link,
    .contact-note p {
      font-size: 0.9rem;
    }
  }
</style>
