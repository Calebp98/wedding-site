---
// Photo Gallery Component
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";

// Number of photos shown before the "Show all" button
const INITIAL_COUNT = 12;

const modules = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/gallery/*.{jpeg,jpg,png}",
  { eager: true }
);

const photos = await Promise.all(
  Object.keys(modules)
    .sort()
    .map(async (path) => {
      const src = modules[path].default;
      const thumb = await getImage({ src, width: 600, format: "webp", quality: 75 });
      // Originals are already WhatsApp-compressed; re-encoding makes them bigger
      return {
        thumb: thumb.src,
        full: src.src,
        width: thumb.attributes.width,
        height: thumb.attributes.height,
      };
    })
);
---

<section class="gallery" id="photos">
  <div class="gallery-heading">
    <div class="gallery-date">12 September 2026</div>
    <h2 class="gallery-title">Photos</h2>
  </div>

  <div class="gallery-grid">
    {
      photos.map((photo, i) => (
        <button
          class="gallery-item"
          data-index={i}
          data-full={photo.full}
          hidden={i >= INITIAL_COUNT}
          aria-label={`Open photo ${i + 1} of ${photos.length}`}
        >
          <img
            src={photo.thumb}
            width={photo.width}
            height={photo.height}
            alt=""
            loading={i < 6 ? "eager" : "lazy"}
            decoding="async"
          />
        </button>
      ))
    }
  </div>

  {
    photos.length > INITIAL_COUNT && (
      <div class="gallery-more-row">
        <button class="gallery-more">Show all {photos.length} photos</button>
      </div>
    )
  }
</section>

<div class="lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button class="lightbox-close" aria-label="Close">×</button>
  <button class="lightbox-prev" aria-label="Previous photo">‹</button>
  <img class="lightbox-img" alt="" />
  <button class="lightbox-next" aria-label="Next photo">›</button>
  <div class="lightbox-count"></div>
</div>

<style>
  .gallery {
    max-width: 1200px;
    margin: 1rem auto 4rem;
    padding: 0 2rem;
    box-sizing: border-box;
  }

  .gallery-heading {
    text-align: center;
    margin-bottom: 2rem;
  }

  .gallery-date {
    font-variant: small-caps;
    letter-spacing: 0.15em;
    color: #555;
    font-size: 1rem;
  }

  .gallery-title {
    font-size: 2rem;
    font-weight: 400;
    margin: 0.5rem 0 0;
    color: #111;
  }

  .gallery-grid {
    columns: 3;
    column-gap: 0.75rem;
  }

  .gallery-item {
    display: block;
    width: 100%;
    margin: 0 0 0.75rem;
    padding: 0;
    border: none;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
  }

  .gallery-item[hidden] {
    display: none;
  }

  .gallery-item img {
    display: block;
    width: 100%;
    height: auto;
    transition: opacity 0.2s ease;
  }

  .gallery-item:hover img {
    opacity: 0.85;
  }

  .gallery-more-row {
    text-align: center;
    margin-top: 1.5rem;
  }

  .gallery-more {
    border: 2px solid #111;
    padding: 0.75rem 1.5rem;
    font-family: inherit;
    font-size: 0.85rem;
    font-variant: small-caps;
    letter-spacing: 0.08em;
    color: #111;
    background-color: transparent;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease;
  }

  .gallery-more:hover {
    background-color: #111;
    color: #fffff8;
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 3000;
    background-color: rgba(10, 10, 10, 0.95);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox[hidden] {
    display: none;
  }

  .lightbox-img {
    max-width: calc(100vw - 8rem);
    max-height: calc(100vh - 6rem);
    object-fit: contain;
  }

  .lightbox button {
    position: absolute;
    background: none;
    border: none;
    color: #fffff8;
    font-family: inherit;
    font-size: 2.5rem;
    line-height: 1;
    cursor: pointer;
    padding: 1rem;
    opacity: 0.7;
    transition: opacity 0.15s ease;
  }

  .lightbox button:hover {
    opacity: 1;
  }

  .lightbox-close {
    top: 0.5rem;
    right: 0.5rem;
  }

  .lightbox-prev {
    left: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-next {
    right: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
  }

  .lightbox-count {
    position: absolute;
    bottom: 1rem;
    left: 50%;
    transform: translateX(-50%);
    color: #aaa;
    font-size: 0.9rem;
    letter-spacing: 0.1em;
  }

  @media (max-width: 900px) {
    .gallery-grid {
      columns: 2;
    }
  }

  @media (max-width: 768px) {
    .gallery {
      padding: 0 1rem;
    }

    .gallery-grid {
      column-gap: 0.5rem;
    }

    .gallery-item {
      margin-bottom: 0.5rem;
    }

    .gallery-title {
      font-size: 1.5rem;
    }

    .lightbox-img {
      max-width: 100vw;
      max-height: calc(100vh - 8rem);
    }

    .lightbox-prev,
    .lightbox-next {
      top: auto;
      bottom: 0;
      transform: none;
    }
  }
</style>

<script>
  const items = Array.from(
    document.querySelectorAll<HTMLButtonElement>(".gallery-item")
  );
  const moreButton = document.querySelector<HTMLButtonElement>(".gallery-more");
  const lightbox = document.querySelector<HTMLDivElement>(".lightbox")!;
  const lightboxImg = lightbox.querySelector<HTMLImageElement>(".lightbox-img")!;
  const lightboxCount = lightbox.querySelector<HTMLDivElement>(".lightbox-count")!;
  let current = 0;
  let touchStartX: number | null = null;

  moreButton?.addEventListener("click", () => {
    items.forEach((item) => (item.hidden = false));
    moreButton.parentElement?.remove();
  });

  function show(index: number) {
    current = (index + items.length) % items.length;
    lightboxImg.src = items[current].dataset.full!;
    lightboxCount.textContent = `${current + 1} / ${items.length}`;
    // Preload neighbours so arrowing through feels instant
    [current - 1, current + 1].forEach((i) => {
      const item = items[(i + items.length) % items.length];
      new Image().src = item.dataset.full!;
    });
  }

  function open(index: number) {
    show(index);
    lightbox.hidden = false;
    document.body.style.overflow = "hidden";
  }

  function close() {
    lightbox.hidden = true;
    document.body.style.overflow = "";
    items[current].focus();
  }

  items.forEach((item, i) => item.addEventListener("click", () => open(i)));
  lightbox.querySelector(".lightbox-close")!.addEventListener("click", close);
  lightbox
    .querySelector(".lightbox-prev")!
    .addEventListener("click", () => show(current - 1));
  lightbox
    .querySelector(".lightbox-next")!
    .addEventListener("click", () => show(current + 1));

  // Clicking the dark backdrop (not the photo or controls) closes
  lightbox.addEventListener("click", (e) => {
    if (e.target === lightbox) close();
  });

  document.addEventListener("keydown", (e) => {
    if (lightbox.hidden) return;
    if (e.key === "Escape") close();
    if (e.key === "ArrowLeft") show(current - 1);
    if (e.key === "ArrowRight") show(current + 1);
  });

  lightbox.addEventListener("touchstart", (e) => {
    touchStartX = e.touches[0].clientX;
  });
  lightbox.addEventListener("touchend", (e) => {
    if (touchStartX === null) return;
    const dx = e.changedTouches[0].clientX - touchStartX;
    if (Math.abs(dx) > 50) show(current + (dx < 0 ? 1 : -1));
    touchStartX = null;
  });
</script>
