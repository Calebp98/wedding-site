---
// Collapsible Section Component
interface Props {
  title: string;
  id: string;
}

const { title, id } = Astro.props;
---

<div class="collapsible-wrapper" data-section={id} id={id}>
  <button class="collapsible-header" aria-expanded="false" aria-controls={`content-${id}`}>
    <h2 class="collapsible-title">{title}</h2>
    <span class="expand-icon" aria-hidden="true">+</span>
  </button>
  <div class="collapsible-content" id={`content-${id}`} aria-hidden="true">
    <div class="collapsible-inner">
      <slot />
    </div>
  </div>
</div>

<style>
  .collapsible-wrapper {
    max-width: 700px;
    margin: 0 auto 2rem;
    width: 100%;
    box-sizing: border-box;
  }

  .collapsible-header {
    width: 100%;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem 2rem;
    background-color: #fffff8;
    border: 2px solid #111;
    cursor: pointer;
    transition: background-color 0.2s ease;
    text-align: left;
    font-family: inherit;
  }

  .collapsible-header:hover {
    background-color: #f5f5f0;
  }

  .collapsible-header[aria-expanded="true"] {
    border-bottom: none;
  }

  .collapsible-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 400;
    color: #111;
    font-family: inherit;
    letter-spacing: normal;
  }

  .expand-icon {
    font-size: 2rem;
    font-weight: 300;
    color: #111;
    transition: transform 0.3s ease;
    line-height: 1;
  }

  .collapsible-header[aria-expanded="true"] .expand-icon {
    transform: rotate(45deg);
  }

  .collapsible-content {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.4s ease;
    border: 2px solid #111;
    border-top: none;
    background-color: #fffff8;
  }

  .collapsible-header[aria-expanded="true"] + .collapsible-content {
    max-height: 5000px;
  }

  .collapsible-inner {
    padding: 2rem;
  }

  @media (max-width: 768px) {
    .collapsible-wrapper {
      margin: 0 1rem 2rem;
    }

    .collapsible-header {
      padding: 1.25rem 1.5rem;
    }

    .collapsible-title {
      font-size: 1.25rem;
    }

    .expand-icon {
      font-size: 1.75rem;
    }

    .collapsible-inner {
      padding: 1.5rem;
    }
  }
</style>

<script>
  document.querySelectorAll('.collapsible-header').forEach(button => {
    button.addEventListener('click', () => {
      const isExpanded = button.getAttribute('aria-expanded') === 'true';
      const content = button.nextElementSibling;

      button.setAttribute('aria-expanded', String(!isExpanded));
      if (content) {
        content.setAttribute('aria-hidden', String(isExpanded));
      }
    });
  });
</script>
