---
// Tree Background Component with p5.js
---

<div id="tree-canvas-container"></div>

<style>
  #tree-canvas-container {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: -9999;
    overflow: hidden;
  }

  #tree-canvas-container canvas {
    display: block;
  }
</style>

<script>
  // Use dynamic import for p5 to ensure it loads properly on client
  let p5Instance: any = null;
  let padding = 0; // No padding - full window
  let currentTreeDepth = 12; // Start with full tree
  let treeRandomSeed = 42; // Fixed seed for consistent tree
  let currentScrollPercentage = 0; // Track scroll for sun shimmer effect

  // Use Tufte background color
  const backgroundColor = "#fffff8";
  const treeColor = "#A67C52"; // Pastel brown for tree
  const grassColor = "#7A9B76"; // Dark pastel green for grass
  const sunColor = "#D8885F"; // Burnt pastel orange for sun

  // Watercolor distribution function (from Barney Codes)
  function distribute(x: number): number {
    return Math.pow((x - 0.5) * 1.58740105, 3) + 0.5;
  }

  function rand(p: any): number {
    return distribute(p.random(1));
  }

  // Watercolor line effect - draws multiple offset versions for bleeding effect
  function watercolorLine(p: any, x1: number, y1: number, x2: number, y2: number, weight: number, color: string, layers: number = 20) {
    p.push();
    const r = parseInt(color.slice(1, 3), 16);
    const g = parseInt(color.slice(3, 5), 16);
    const b = parseInt(color.slice(5, 7), 16);

    p.noFill();

    // Draw multiple layers with slight variations
    for (let i = 0; i < layers; i++) {
      const alpha = 255 / (2 * layers);
      p.stroke(r, g, b, alpha);
      p.strokeWeight(weight + p.random(-weight * 0.3, weight * 0.3));

      // Add variation to line endpoints
      const offsetX1 = x1 + p.random(-weight * 0.5, weight * 0.5);
      const offsetY1 = y1 + p.random(-weight * 0.5, weight * 0.5);
      const offsetX2 = x2 + p.random(-weight * 0.5, weight * 0.5);
      const offsetY2 = y2 + p.random(-weight * 0.5, weight * 0.5);

      // Draw with slight wobble
      const steps = 5;
      p.beginShape();
      p.vertex(offsetX1, offsetY1);
      for (let j = 1; j < steps; j++) {
        const t = j / steps;
        const x = p.lerp(offsetX1, offsetX2, t) + rand(p) * weight * 0.3 - weight * 0.15;
        const y = p.lerp(offsetY1, offsetY2, t) + rand(p) * weight * 0.3 - weight * 0.15;
        p.vertex(x, y);
      }
      p.vertex(offsetX2, offsetY2);
      p.endShape();
    }
    p.pop();
  }

  function branch(p: any, depth: number, maxDepth: number) {
    if (depth < maxDepth) {
      const len = p.height / 12;
      const baseWeight = Math.max(1, 6 - depth * 0.4); // Thinner branches at higher depths

      // Draw watercolor line instead of regular line
      watercolorLine(p, 0, 0, 0, -len, baseWeight, treeColor, 8);

      p.translate(0, -len);
      p.rotate(p.random(-0.05, 0.05));

      if (p.random() < 0.65) {
        p.rotate(0.3);
        p.scale(0.8);
        p.push();
        branch(p, depth + 1, maxDepth);
        p.pop();
        p.rotate(-0.6);
        p.push();
        branch(p, depth + 1, maxDepth);
        p.pop();
      } else {
        branch(p, depth, maxDepth);
      }
    }
  }

  function drawGrass(p: any) {
    p.push();

    // Draw grass blades with watercolor effect - lighter layers
    for (let x = 0; x < p.width; x += p.random(1.5)) {
      const baseY = p.height;
      const topY = baseY - (p.height / 32 + p.noise(x / 5) * 15 - 7.5);
      const topX = x + p.random(-2.5, 2.5);
      watercolorLine(p, x, baseY, topX, topY, 0.5, grassColor, 4);
    }

    // Add occasional flowers with watercolor stems
    for (let x = 0; x < p.width; x += p.random(150)) {
      const baseY = p.height;
      const stemY = baseY - (p.height / 20 + p.noise(x) * 17.5 - 12.5);
      const stemX = x + p.random(-7.5, 7.5);
      watercolorLine(p, x, baseY, stemX, stemY, 1, grassColor, 5);

      // Draw flower head with watercolor effect
      p.push();
      const r = parseInt(grassColor.slice(1, 3), 16);
      const g = parseInt(grassColor.slice(3, 5), 16);
      const b = parseInt(grassColor.slice(5, 7), 16);
      p.noStroke();
      const flowerSize = p.random(3, 5);
      for (let i = 0; i < 5; i++) {
        p.fill(r, g, b, 50);
        const offsetX = p.random(-flowerSize * 0.3, flowerSize * 0.3);
        const offsetY = p.random(-flowerSize * 0.3, flowerSize * 0.3);
        p.circle(stemX + offsetX, stemY + offsetY, flowerSize);
      }
      p.pop();
    }
    p.pop();
  }

  // Watercolor ray for sun
  function watercolorRay(p: any, x1: number, y1: number, x2: number, y2: number, weight: number, color: string, layers: number = 2) {
    const r = parseInt(color.slice(1, 3), 16);
    const g = parseInt(color.slice(3, 5), 16);
    const b = parseInt(color.slice(5, 7), 16);

    for (let i = 0; i < layers; i++) {
      const alpha = 255 / (2 * layers);
      p.stroke(r, g, b, alpha);
      p.strokeWeight(weight + p.random(-weight * 0.2, weight * 0.2));

      const offsetX2 = x2 + p.random(-weight * 2, weight * 2);
      const offsetY2 = y2 + p.random(-weight * 2, weight * 2);

      p.line(x1, y1, offsetX2, offsetY2);
    }
  }

  function drawSun(p: any) {
    p.push();

    // Use scroll percentage to vary random seed for shimmer effect
    const shimmerSeed = Math.floor(currentScrollPercentage * 100) + 42;
    p.randomSeed(shimmerSeed);

    // Sun setup
    const sunBeamWidth = p.random(0.15, 0.45);
    const sunX = p.width * 0.15;
    const sunY = p.height * 0.35;
    p.translate(sunX, sunY);

    const sunFirstPart = p.random(75, 100);

    // First part of the sun - outer rays with watercolor
    p.noFill();
    let numLines1 = p.random(350, 450);
    for (let i = 0; i < numLines1; i++) {
      let angle = (i * p.TWO_PI) / numLines1;
      let offsetEnd = p.random(25, 45);
      let x = (sunFirstPart + offsetEnd) * p.cos(angle);
      let y = (sunFirstPart + offsetEnd) * p.sin(angle);
      watercolorRay(p, 0, 0, x, y, sunBeamWidth / 3, sunColor, 2);
    }

    // Second part - filled circle and middle rays
    p.fill(backgroundColor);
    p.noStroke();
    p.circle(0, 0, sunFirstPart * 2.2);
    p.noFill();
    let numLines2 = p.random(350, 450);
    for (let i = 0; i < numLines2; i++) {
      let angle = (i * p.TWO_PI) / numLines2;
      let offsetEnd = p.random(10, 25);
      let x = (sunFirstPart + offsetEnd) * p.cos(angle);
      let y = (sunFirstPart + offsetEnd) * p.sin(angle);
      watercolorRay(p, 0, 0, x, y, sunBeamWidth / 2, sunColor, 2);
    }

    // Third part - another filled circle and inner rays
    p.fill(backgroundColor);
    p.noStroke();
    p.circle(0, 0, sunFirstPart * 1.5);
    p.noFill();
    let numLines3 = p.random(250, 350);
    for (let i = 0; i < numLines3; i++) {
      let angle = (i * p.TWO_PI) / numLines3;
      let offsetEnd = p.random(10, 25);
      let x = (sunFirstPart / 1.5 + offsetEnd) * p.cos(angle);
      let y = (sunFirstPart / 1.5 + offsetEnd) * p.sin(angle);
      watercolorRay(p, 0, 0, x, y, sunBeamWidth, sunColor, 2);
    }

    // Final - center circle with watercolor edge
    const r = parseInt(sunColor.slice(1, 3), 16);
    const g = parseInt(sunColor.slice(3, 5), 16);
    const b = parseInt(sunColor.slice(5, 7), 16);

    p.fill(backgroundColor);
    p.noStroke();
    p.circle(0, 0, sunFirstPart / 1.5 - sunBeamWidth * 1.5);

    // Watercolor circle edge
    for (let i = 0; i < 5; i++) {
      p.noFill();
      p.stroke(r, g, b, 50);
      p.strokeWeight(sunBeamWidth * 1.5 + p.random(-sunBeamWidth * 0.3, sunBeamWidth * 0.3));
      const offset = p.random(-1, 1);
      p.circle(offset, offset, sunFirstPart / 1.5);
    }

    p.pop();
  }

  function generateTree(p: any) {
    p.push();
    p.randomSeed(treeRandomSeed); // Use same seed for consistent tree
    p.translate(p.width * 0.85, p.height);
    p.stroke(treeColor);
    p.fill(0, 0, 0, 0);
    branch(p, p.random(0, 10), currentTreeDepth);
    p.pop();
  }

  function generateArt(p: any) {
    console.log('Generating tree art with depth:', currentTreeDepth);
    p.background(backgroundColor);
    p.randomSeed(42); // Same seed for consistent grass
    drawSun(p);
    drawGrass(p);
    generateTree(p);
  }

  function handleScroll() {
    const scrollPercentage = window.scrollY / (document.documentElement.scrollHeight - window.innerHeight);
    currentScrollPercentage = scrollPercentage;

    // At top (0%): depth = 12 (full tree with all branches)
    // At bottom (100%): depth = 2 (sapling with just a few branches)
    // This makes it look like tree is growing as you scroll UP
    const newDepth = Math.round(12 - (scrollPercentage * 10));
    const clampedDepth = Math.max(2, Math.min(12, newDepth));

    if (clampedDepth !== currentTreeDepth) {
      currentTreeDepth = clampedDepth;
      if (p5Instance) {
        generateArt(p5Instance);
      }
    }
  }

  // Initialize when DOM is ready
  async function initializeTree() {
    console.log('Initializing tree...');
    const container = document.getElementById('tree-canvas-container');
    if (!container) {
      console.error('Tree canvas container not found!');
      return;
    }
    console.log('Container found:', container);

    try {
      // Dynamic import of p5
      const p5Module = await import('p5');
      const p5 = p5Module.default;
      console.log('p5 loaded successfully');

      p5Instance = new p5((p: any) => {
        p.setup = () => {
          console.log('p5 setup running...', 'Window size:', p.windowWidth, 'x', p.windowHeight);
          const canvas = p.createCanvas(p.windowWidth, p.windowHeight);
          canvas.parent('tree-canvas-container');
          p.pixelDensity(2);
          p.noLoop();
          generateArt(p);
        };

        p.draw = () => {};

        p.windowResized = () => {
          console.log('Window resized, regenerating tree');
          p.resizeCanvas(p.windowWidth, p.windowHeight);
          generateArt(p);
        };
      });

      window.addEventListener('scroll', handleScroll);
      console.log('Tree initialization complete');
    } catch (error) {
      console.error('Error initializing tree:', error);
    }
  }

  // Run when component loads
  if (typeof window !== 'undefined') {
    initializeTree();
  }
</script>
