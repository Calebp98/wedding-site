---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import TimelineSection from "../components/TimelineSection.astro";
import DaysCounter from "../components/DaysCounter.astro";
import WeddingInfo from "../components/WeddingInfo.astro";
import CollapsibleSection from "../components/CollapsibleSection.astro";
import Schedule from "../components/Schedule.astro";
import Menu from "../components/Menu.astro";
import Accommodations from "../components/Accommodations.astro";
import Contact from "../components/Contact.astro";
import "../styles/global.css";
---

<Layout title="Our Story">
  <div class="hero">
    <h1>Our Story</h1>
    <p>A journey of love</p>
  </div>

  <Navigation />

  <div class="wedding-celebration">
    <div class="celebration-date">September 12, 2026</div>
    <h2 class="celebration-title">The Wedding</h2>
    <p>
      Today we celebrate the beginning of our forever. Surrounded by loved ones,
      we promise to walk through life together, hand in hand, heart to heart.
    </p>
    <p>
      This is not the end of our story—it's the most beautiful chapter yet to
      unfold.
    </p>
  </div>

  <div class="info-and-counter-wrapper">
    <WeddingInfo />
    <DaysCounter />
  </div>

  <CollapsibleSection title="Schedule of Events" id="schedule">
    <Schedule />
  </CollapsibleSection>

  <CollapsibleSection title="Menu" id="menu">
    <Menu />
  </CollapsibleSection>

  <CollapsibleSection title="Accommodations" id="accommodations">
    <Accommodations />
  </CollapsibleSection>

  <CollapsibleSection title="Questions?" id="contact">
    <Contact />
  </CollapsibleSection>

  <article>
    <TimelineSection
      eventDate="2025-03-20"
      eventName="The Proposal"
      displayDate="March 2025"
      title="The Proposal"
    >
      <p>
        The moment we decided to make it official. <span class="marginnote"
          >Add your proposal story here—where were you, what made it special,
          how did it feel?</span
        >
      </p>
      <p>A memory we'll treasure forever, the day our future became certain.</p>
    </TimelineSection>

    <TimelineSection
      eventDate="2023-09-10"
      eventName="Growing Together"
      displayDate="September 2023"
      title="Growing Together"
    >
      <p>
        Through seasons of change, we grew stronger. Late-night conversations,
        shared dreams, quiet moments that meant everything.
      </p>
      <p>
        We learned that love isn't just a feeling—it's a choice we make every
        day.
      </p>
    </TimelineSection>

    <TimelineSection
      eventDate="2022-07-04"
      eventName="The First Adventure"
      displayDate="July 2022"
      title="The First Adventure"
    >
      <p>
        Our first trip together. <span class="marginnote"
          >Replace with your first meaningful trip or adventure as a couple.</span
        >
      </p>
      <p>We discovered that the best journeys are the ones we take together.</p>
    </TimelineSection>

    <TimelineSection
      eventDate="2021-11-25"
      eventName="Falling Deeper"
      displayDate="November 2021"
      title="Falling Deeper"
    >
      <p>
        Somewhere between the laughter and the ordinary days, we realized this
        was different. This was real.
      </p>
      <p>The kind of love that makes you believe in forever.</p>
    </TimelineSection>

    <TimelineSection
      eventDate="2021-05-14"
      eventName="The First Date"
      displayDate="May 2021"
      title="The First Date"
    >
      <p>
        Nervous excitement, hopeful hearts. We didn't know then that this was
        the beginning of everything.
      </p>
      <p>Sometimes the best stories start with the smallest moments.</p>
    </TimelineSection>

    <TimelineSection
      eventDate="2021-04-01"
      eventName="The First Hello"
      displayDate="April 2021"
      title="The First Hello"
    >
      <p>
        Two paths crossed. A chance encounter, a shared glance, a conversation
        that changed everything.
      </p>
      <p>
        This is where our story begins. <span class="marginnote"
          >Tell your origin story—how did you meet? What do you remember about
          that first meeting?</span
        >
      </p>
    </TimelineSection>
  </article>
</Layout>

<script>
  // Intersection Observer for scroll-triggered animations
  const observerOptions: IntersectionObserverInit = {
    threshold: 0.2,
    rootMargin: "0px 0px -100px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
      }
    });
  }, observerOptions);

  // Observe all timeline sections
  document
    .querySelectorAll(".timeline-section")
    .forEach((element) => {
      observer.observe(element);
    });
</script>
