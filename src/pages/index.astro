---
import Layout from "../layouts/Layout.astro";
import Navigation from "../components/Navigation.astro";
import TimelineSection from "../components/TimelineSection.astro";
import DaysCounter from "../components/DaysCounter.astro";
import WeddingInfo from "../components/WeddingInfo.astro";
import CollapsibleSection from "../components/CollapsibleSection.astro";
import Schedule from "../components/Schedule.astro";
import Menu from "../components/Menu.astro";
import Accommodations from "../components/Accommodations.astro";
import Contact from "../components/Contact.astro";
import "../styles/global.css";
---

<Layout title="Our Story">
  <div class="hero">
    <h1>[Your Names]</h1>
    <p>Lorem ipsum dolor sit amet</p>
  </div>

  <Navigation />

  <div class="wedding-celebration">
    <div class="celebration-date">[Wedding Date]</div>
    <h2 class="celebration-title">[The Wedding]</h2>
    <p>
      Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod
      tempor incididunt ut labore et dolore magna aliqua.
    </p>
    <p>
      Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris nisi
      ut aliquip ex ea commodo consequat.
    </p>
  </div>

  <div class="info-and-counter-wrapper">
    <WeddingInfo />
    <DaysCounter />
  </div>

  <CollapsibleSection title="Schedule of Events" id="schedule">
    <Schedule />
  </CollapsibleSection>

  <CollapsibleSection title="Menu" id="menu">
    <Menu />
  </CollapsibleSection>

  <CollapsibleSection title="Accommodations" id="accommodations">
    <Accommodations />
  </CollapsibleSection>

  <CollapsibleSection title="Questions?" id="contact">
    <Contact />
  </CollapsibleSection>

  <article>
    <TimelineSection
      eventDate="2025-03-20"
      eventName="[engaged]"
      displayDate="[Month Year]"
      title="[engaged]"
    >
      <p>
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. <span class="marginnote"
          >Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua.</span
        >
      </p>
      <p>Ut enim ad minim veniam, quis nostrud exercitation ullamco laboris.</p>
    </TimelineSection>

    <TimelineSection
      eventDate="2023-09-10"
      eventName="[anniversary celebration]"
      displayDate="[Month Year]"
      title="[anniversary celebration]"
    >
      <p>
        Duis aute irure dolor in reprehenderit in voluptate velit esse cillum
        dolore eu fugiat nulla pariatur.
      </p>
      <p>
        Excepteur sint occaecat cupidatat non proident, sunt in culpa qui
        officia deserunt mollit anim.
      </p>
    </TimelineSection>

    <TimelineSection
      eventDate="2022-07-04"
      eventName="[first trip together]"
      displayDate="[Month Year]"
      title="[first trip together]"
    >
      <p>
        Sed ut perspiciatis unde omnis iste natus error sit voluptatem. <span class="marginnote"
          >Accusantium doloremque laudantium totam rem aperiam.</span
        >
      </p>
      <p>Eaque ipsa quae ab illo inventore veritatis et quasi architecto.</p>
    </TimelineSection>

    <TimelineSection
      eventDate="2021-11-25"
      eventName="[became official]"
      displayDate="[Month Year]"
      title="[became official]"
    >
      <p>
        Nemo enim ipsam voluptatem quia voluptas sit aspernatur aut odit aut
        fugit, sed quia consequuntur.
      </p>
      <p>Neque porro quisquam est, qui dolorem ipsum quia dolor sit amet.</p>
    </TimelineSection>

    <TimelineSection
      eventDate="2021-05-14"
      eventName="[first date]"
      displayDate="[Month Year]"
      title="[first date]"
    >
      <p>
        Consectetur, adipisci velit, sed quia non numquam eius modi tempora
        incidunt ut labore et dolore magnam.
      </p>
      <p>Aliquam quaerat voluptatem ut enim ad minima veniam.</p>
    </TimelineSection>

    <TimelineSection
      eventDate="2021-04-01"
      eventName="[caleb and grace first met]"
      displayDate="[Month Year]"
      title="[caleb and grace first met]"
    >
      <p>
        Quis autem vel eum iure reprehenderit qui in ea voluptate velit esse
        quam nihil molestiae consequatur.
      </p>
      <p>
        Vel illum qui dolorem eum fugiat quo voluptas nulla pariatur. <span class="marginnote"
          >At vero eos et accusamus et iusto odio dignissimos ducimus.</span
        >
      </p>
    </TimelineSection>
  </article>
</Layout>

<script>
  // Intersection Observer for scroll-triggered animations
  const observerOptions: IntersectionObserverInit = {
    threshold: 0.2,
    rootMargin: "0px 0px -100px 0px",
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        entry.target.classList.add("visible");
      }
    });
  }, observerOptions);

  // Observe all timeline sections
  document
    .querySelectorAll(".timeline-section")
    .forEach((element) => {
      observer.observe(element);
    });
</script>
